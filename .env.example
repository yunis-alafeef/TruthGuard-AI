# ==========================================
# TruthGuard AI - Environment Configuration
# Add these in Vercel Dashboard: Project Settings -> Environment Variables
# ==========================================

# 1. Google Gemini AI API (Required for reasoning synthesis over evidence)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Tavily Real-Time News Search API (Recommended for live news search - 1,000 free queries/month)
# Get your key at: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# 3. Google Fact Check Tools API (Optional for IFCN verified database queries)
# Enable at: https://console.cloud.google.com/apis/library/factchecktools.googleapis.com
GOOGLE_FACTCHECK_API_KEY=your_google_cloud_api_key_here

# Runtime Environment
NODE_ENV=production
PORT=3000
